{
  "name": "dsh-grok-acp",
  "version": "0.2.0",
  "type": "module",
  "description": "Use Grok Build as an ACP-powered root agent inside DeepSeek Harness Web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmh2000829/DSH-agent-bridge.git"
  },
  "homepage": "https://github.com/zmh2000829/DSH-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/zmh2000829/DSH-agent-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "grok-build",
    "agent-client-protocol",
    "acp",
    "coding-agent"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./preset-marker": "./lib/preset-marker.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-grok": "bin/dsh-grok.mjs"
  },
  "files": [
    "bin",
    "lib/*.js",
    "presets",
    "docs/assets",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "test": "node --test tests/*.spec.js",
    "check": "npm test && npm run build",
    "prepack": "npm run check"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  }
}
